# ── Banco de dados ────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=db_gvc_display
DB_USER=root
DB_PASS=

# ── Aplicação ─────────────────────────────────────────────────
