# GVC Display MVC — Apache / XAMPP

DirectoryIndex index.php index.html

<IfModule mod_mime.c>
  AddHandler application/x-httpd-php .php
</IfModule>

<IfModule mod_setenvif.c>
  SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /gvc-display/

  # Arquivos físicos existentes — serve direto
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Pastas estáticas — serve direto
  RewriteCond %{REQUEST_URI} ^/gvc-display/(uploads|assets|resources)/
  RewriteRule ^ - [L]

  # Preserva o método HTTP explicitamente antes do rewrite
  RewriteRule ^ index.php [QSA,L]
</IfModule>

# FallbackResource como backup caso o mod_rewrite não funcione corretamente
# Isso garante que QUALQUER request não resolvido vai para o index.php
# preservando o método HTTP original
<IfModule !mod_rewrite.c>
  FallbackResource /gvc-display/index.php
</IfModule>
